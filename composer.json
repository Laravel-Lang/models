{
    "name": "laravel-lang/models",
    "description": "Easy and fast way to localize models",
    "license": "MIT",
    "keywords": [
        "laravel-lang",
        "i18n",
        "models",
        "translations",
        "translate",
        "localization",
        "locales"
    ],
    "authors": [
        {
            "name": "Andrey Helldar",
            "email": "helldar@dragon-code.pro"
        },
        {
            "name": "Andrey Sokolov",
            "email": "walfireru@gmail.com",
            "homepage": "https://github.com/Quiss",
            "role": "Usability consultant"
        },
        {
            "name": "Laravel-Lang Team",
            "homepage": "https://github.com/Laravel-Lang"
        }
    ],
    "support": {
        "source": "https://github.com/Laravel-Lang/mona"
    },
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "composer/class-map-generator": "^1.9",
        "illuminate/console": "^12.0 || ^13.0 || dev-master",
        "illuminate/contracts": "^12.0 || ^13.0 || dev-master",
        "illuminate/database": "^12.0 || ^13.0 || dev-master",
        "illuminate/support": "^12.0 || ^13.0 || dev-master",
        "laravel-lang/config": "self.version",
        "laravel-lang/exceptions": "self.version",
        "laravel-lang/filesystem": "self.version",
        "laravel-lang/locale-list": "self.version",
        "laravel-lang/locale-names": "self.version",
        "laravel-lang/locales": "self.version",
        "symfony/polyfill-php86": "^1.43"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "LaravelLang\\Models\\": "src/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelLang\\Models\\LangModelsServiceProvider"
            ]
        }
    }
}
